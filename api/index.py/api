from flask import Flask, request, jsonify
import requests

app = Flask(__name__)

@app.route('/api/watershed', methods=['GET'])
def get_watershed():
    lat = request.args.get('lat')
    lng = request.args.get('lng')
    precision = request.args.get('precision', 'high')

    if not lat or not lng:
        return jsonify({"error": "Latitude and longitude required"}), 400

    mghydro_url = f"https://mghydro.com/app/watershed_api?lat={lat}&lng={lng}&precision={precision}"
    
    try:
        response = requests.get(mghydro_url)
        return jsonify(response.json())
    except Exception as e:
        return jsonify({"error": str(e)}), 500

